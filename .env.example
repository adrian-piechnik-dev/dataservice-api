# Copy this file to .env and adjust the values. Settings are read from the
# environment first and from .env locally (see src/ap_dataservice/config.py).
# A missing required value stops the application from starting.

# Database connection URL, handed straight to the SQLAlchemy async engine.
# The driver is part of the URL, so switching backends is a one-line change.
#   SQLite (development):    sqlite+aiosqlite:///./app.db
#   PostgreSQL (production): postgresql+asyncpg://user:pass@localhost:5432/dbname
# required
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Shared secret the client has to send in the X-API-Key header. Every request
# to /stories is rejected with 401 without it. Replace this placeholder before
# any deployment - it is public in the template.
# required
API_KEY=change-me

# Page size used when a request carries no explicit limit.
# optional, default shown
DEFAULT_PAGE_SIZE=50

# Upper bound for limit; a larger value is rejected with 422.
# optional, default shown
MAX_PAGE_SIZE=200

# Upper bound for offset; a larger value is rejected with 422. Paging past this
# makes the database build and discard the whole prefix on every request.
# optional, default shown
MAX_OFFSET=100000

# Whether POST, PATCH and DELETE on /stories are served. The demo deployment
# publishes its API key, so it runs read-only - anybody who can read the key
# could otherwise rewrite the data everybody else sees. Set this to true in a
# local clone to get the full CRUD back.
# optional, default shown
ENABLE_WRITE_ENDPOINTS=false

# Host names the service answers to, comma-separated. A request whose Host
# header matches none of them gets a 400 before any handler runs. A leading
# "*." matches subdomains. Add your own domain here when you attach one.
# optional, default shown
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com

# Service name shown in /docs and openapi.json.
# optional, default shown
APP_TITLE=dataservice-api

# One-line summary shown in /docs and openapi.json.
# optional, default shown
APP_DESCRIPTION=REST API serving Hacker News front-page stories collected by the smartscraper-ai pipeline. Async FastAPI + SQLAlchemy 2.0 over PostgreSQL, with API-key auth, filtering, pagination and Alembic migrations.

# Version reported in openapi.json; keep it in step with pyproject.toml.
# optional, default shown
APP_VERSION=0.1.0
